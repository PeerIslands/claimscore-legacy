<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts-config PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 1.3//EN"
    "http://struts.apache.org/dtds/struts-config_1_3.dtd">
<!-- $Id: struts-config.xml,v 1.21 2014/11/03 16:20:44 dvasquez Exp $ -->
<struts-config>

    <form-beans>
        <form-bean name="claimForm" type="com.claimscore.struts.ClaimForm"/>
        <form-bean name="loginForm" type="org.apache.struts.action.DynaActionForm">
            <form-property name="username" type="java.lang.String"/>
            <form-property name="password" type="java.lang.String"/>
        </form-bean>
    </form-beans>

    <global-forwards>
        <forward name="login" path="/login.do"/>
        <forward name="error" path="/WEB-INF/jsp/error.jsp"/>
    </global-forwards>

    <action-mappings>
        <action path="/login"
                type="com.claimscore.struts.LoginAction"
                name="loginForm"
                scope="request"
                validate="false"
                input="/WEB-INF/jsp/login.jsp">
            <forward name="success" path="/claimSearch.do" redirect="true"/>
            <forward name="failure" path="/WEB-INF/jsp/login.jsp"/>
        </action>

        <action path="/claim"
                type="com.claimscore.struts.ClaimAction"
                name="claimForm"
                scope="request"
                validate="false">
            <forward name="view" path="/WEB-INF/jsp/claim/view.jsp"/>
            <forward name="submit" path="/WEB-INF/jsp/claim/submit.jsp"/>
            <forward name="error" path="/WEB-INF/jsp/error.jsp"/>
        </action>

        <action path="/claimSearch"
                type="com.claimscore.struts.ClaimSearchAction">
            <forward name="search" path="/WEB-INF/jsp/claim/search.jsp"/>
        </action>

        <action path="/policyHolder"
                type="com.claimscore.struts.PolicyHolderAction">
            <forward name="view" path="/WEB-INF/jsp/policyholder/view.jsp"/>
        </action>
    </action-mappings>

    <message-resources parameter="com.claimscore.ApplicationResources"/>

</struts-config>
